# ~/.config/shell_gpt/.sgptrc — ShellGPT pointed at the local sgpt-free adapter.
# You do NOT need to edit this file manually anymore!
# Use local commands instead:
#   sgpt-free --setup
#   sgpt-free --colab <NGROK_URL> [MODEL]
#   sgpt-free --opencode [MODEL]
#   sgpt-free --set-model <MODEL>
#   sgpt-free --status
#   sgpt-free --help    (or: sgpt-f --h)

OPENAI_API_KEY=dummy-local
API_BASE_URL=http://127.0.0.1:8642/v1
DEFAULT_MODEL=SET_YOUR_MODEL_HERE
OPENAI_USE_FUNCTIONS=false
USE_LITELLM=false
REQUEST_TIMEOUT=600
DISABLE_STREAMING=false
