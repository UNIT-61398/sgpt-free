#!/usr/bin/env python3
"""sgpt-free (alias: sgpt-f) — ShellGPT launcher & local backend manager.

Supports two free backends transparently behind the local adapter:
  1. Google Colab + Ollama (ngrok URL)  -> `sgpt-free --colab <URL> [MODEL]`
  2. OpenCode / OpenRouter              -> `sgpt-free --opencode [MODEL]`

Any other flags/arguments are passed directly to the original `sgpt` binary,
so every ShellGPT feature (-s, -c, -d, --chat, --repl, --role, --functions,
stdin piping, etc.) works identically.
"""
from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

PORT = int(os.getenv("SGPT_OC_PORT", "8642"))
ADAPTER_DIR = Path(os.getenv("SGPT_FREE_DIR", str(Path.home() / ".local" / "share" / "sgpt-opencode")))
ADAPTER_PY = ADAPTER_DIR / "adapter.py"
ADAPTER_LOG = ADAPTER_DIR / "adapter.log"
AUDIT_SH = ADAPTER_DIR / "sgpt-audit.sh"
CFG_DIR = Path(os.getenv("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "shell_gpt"
SGPTRC = CFG_DIR / ".sgptrc"
FREE_CFG = Path(os.getenv("SGPT_FREE_CONFIG", str(CFG_DIR / "sgpt-free.json")))
HEALTH_URL = f"http://127.0.0.1:{PORT}/health"

KNOWN_OPENCODE_FREE = [
    "opencode/beam-free",
    "opencode/big-pickle",
    "opencode/deepseek-v4.1-flash-free",
    "opencode/glm-5.3-flash-free",
    "opencode/mimo-v2.6-flash-free",
    "opencode/minimax-m3.1-flash-free",
    "openrouter/recursive/flint-v1.0:free",
]


def prog_name() -> str:
    name = os.path.basename(sys.argv[0] or "sgpt-free")
    return name if name in ("sgpt-free", "sgpt-f") else "sgpt-free"


def normalize_url(url: str) -> str:
    u = (url or "").strip().rstrip("/")
    if not u:
        return ""
    if not u.startswith(("http://", "https://")):
        u = "https://" + u
    for suffix in ("/v1/chat/completions", "/v1/models", "/api/chat", "/api/tags", "/v1"):
        if u.endswith(suffix):
            u = u[: -len(suffix)].rstrip("/")
    return u


def load_free_cfg() -> dict:
    cfg = {
        "backend": "opencode",
        "colab_url": "",
        "colab_model": "",
        "colab_api_key": "",
        "opencode_model": "",
    }
    try:
        if FREE_CFG.exists():
            data = json.loads(FREE_CFG.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                cfg.update({k: v for k, v in data.items() if v is not None})
    except Exception:
        pass
    return cfg


def save_free_cfg(cfg: dict) -> None:
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    FREE_CFG.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")


def read_sgptrc() -> dict[str, str]:
    values: dict[str, str] = {}
    if not SGPTRC.exists():
        return values
    for line in SGPTRC.read_text(encoding="utf-8", errors="replace").splitlines():
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            k, v = s.split("=", 1)
            values[k.strip()] = v.strip()
    return values


def update_sgptrc(updates: dict[str, str]) -> None:
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    text = SGPTRC.read_text(encoding="utf-8", errors="replace") if SGPTRC.exists() else ""
    base_defaults = {
        "OPENAI_API_KEY": "dummy-local",
        "API_BASE_URL": f"http://127.0.0.1:{PORT}/v1",
        "USE_LITELLM": "false",
        "REQUEST_TIMEOUT": "600",
        "DISABLE_STREAMING": "false",
    }
    merged = {**base_defaults, **updates}
    for key, val in merged.items():
        pattern = rf"(?m)^{re.escape(key)}=.*$"
        if re.search(pattern, text):
            text = re.sub(pattern, lambda _m, k=key, v=val: f"{k}={v}", text)
        else:
            text = text.rstrip() + ("\n" if text.strip() else "") + f"{key}={val}\n"
    if not re.search(r"(?m)^DEFAULT_MODEL=", text):
        text = text.rstrip() + "\nDEFAULT_MODEL=SET_YOUR_MODEL_HERE\n"
    SGPTRC.write_text(text.rstrip() + "\n", encoding="utf-8")


def fetch_colab_models(url: str, api_key: str = "") -> list[str]:
    base = normalize_url(url)
    if not base:
        return []
    headers = {
        "Accept": "application/json",
        "ngrok-skip-browser-warning": "true",
        "User-Agent": "sgpt-free/5.0",
    }
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    for path in ("/v1/models", "/api/tags"):
        try:
            req = Request(f"{base}{path}", headers=headers, method="GET")
            with urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
            if isinstance(data, dict):
                if isinstance(data.get("data"), list):
                    ids = [str(m.get("id", "")).strip() for m in data["data"] if isinstance(m, dict)]
                    ids = [x for x in ids if x]
                    if ids:
                        return ids
                if isinstance(data.get("models"), list):
                    ids = [str(m.get("name", "")).strip() for m in data["models"] if isinstance(m, dict)]
                    ids = [x for x in ids if x]
                    if ids:
                        return ids
        except Exception:
            continue
    return []


def check_health() -> dict | None:
    try:
        with urlopen(HEALTH_URL, timeout=2) as resp:
            return json.loads(resp.read().decode("utf-8", errors="replace"))
    except Exception:
        return None


def find_adapter_script() -> Path | None:
    if ADAPTER_PY.exists():
        return ADAPTER_PY
    local = Path(__file__).resolve().parent / "adapter.py"
    if local.exists():
        return local
    return None


def stop_adapter() -> bool:
    stopped = False
    if os.name != "nt":
        for cmd in (["pkill", "-f", "[a]dapter.py"], ["fuser", "-k", f"{PORT}/tcp"]):
            try:
                r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if r.returncode == 0:
                    stopped = True
            except OSError:
                pass
        time.sleep(0.5)
    return stopped


def ensure_adapter(quiet: bool = False) -> bool:
    if check_health():
        return True
    script = find_adapter_script()
    if not script:
        print(f"[sgpt-free] ERROR: adapter.py not found in {ADAPTER_DIR}", file=sys.stderr)
        return False
    ADAPTER_DIR.mkdir(parents=True, exist_ok=True)
    if not quiet:
        print("[sgpt-free] starting local adapter by UNIT-61398...", file=sys.stderr)
    with open(ADAPTER_LOG, "a", encoding="utf-8") as logf:
        popen_kwargs: dict = {
            "stdout": logf,
            "stderr": subprocess.STDOUT,
            "stdin": subprocess.DEVNULL,
        }
        if os.name != "nt":
            popen_kwargs["start_new_session"] = True
        subprocess.Popen([sys.executable, str(script)], **popen_kwargs)
    for _ in range(25):
        if check_health():
            return True
        time.sleep(0.3)
    print(f"[sgpt-free] ERROR: adapter did not start. Check log: {ADAPTER_LOG}", file=sys.stderr)
    return False


