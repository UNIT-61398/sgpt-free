def cmd_colab(args: list[str]) -> int:
    if not args:
        print(f"Usage: {prog_name()} --colab <NGROK_URL> [MODEL]", file=sys.stderr)
        print(f"Example: {prog_name()} --colab https://xxxx.ngrok-free.app sgpt-ai", file=sys.stderr)
        return 1

    url = normalize_url(args[0])
    model = args[1].strip() if len(args) > 1 else ""

    print(f"[sgpt-free] Testing Colab/Ollama server at {url} ...")
    live_models = fetch_colab_models(url)
    if live_models:
        print(f"[sgpt-free] Connected! Models on Colab: {', '.join(live_models)}")
        if not model:
            model = live_models[0]
            print(f"[sgpt-free] Auto-selected model: {model}")
    else:
        print("[sgpt-free] Warning: could not fetch /v1/models right now (saving settings anyway).")
        if not model:
            prev = load_free_cfg().get("colab_model", "")
            model = prev or "sgpt-ai"
            print(f"[sgpt-free] Using model name: {model} (change anytime with --set-model)")

    cfg = load_free_cfg()
    cfg["backend"] = "colab"
    cfg["colab_url"] = url
    cfg["colab_model"] = model
    save_free_cfg(cfg)
    update_sgptrc({"DEFAULT_MODEL": model})
    stop_adapter()
    ensure_adapter(quiet=True)
    print(f"\n[OK] Switched to Colab backend!")
    print(f"     URL   : {url}")
    print(f"     Model : {model}")
    print(f"     Test  : {prog_name()} \"say hi in 3 words\"")
    return 0


def cmd_opencode(args: list[str]) -> int:
    cfg = load_free_cfg()
    model = args[0].strip() if args else (cfg.get("opencode_model") or "")
    cfg["backend"] = "opencode"
    if model:
        cfg["opencode_model"] = model
    save_free_cfg(cfg)
    if model:
        update_sgptrc({"DEFAULT_MODEL": model})
    else:
        rc = read_sgptrc()
        cur = rc.get("DEFAULT_MODEL", "")
        if not cur or cur == "SET_YOUR_MODEL_HERE" or cur == cfg.get("colab_model"):
            update_sgptrc({"DEFAULT_MODEL": "SET_YOUR_MODEL_HERE"})
            model = "SET_YOUR_MODEL_HERE"
        else:
            model = cur
    ensure_adapter(quiet=True)
    print("\n[OK] Switched to OpenCode / OpenRouter backend!")
    print(f"     Model : {model}")
    if model == "SET_YOUR_MODEL_HERE":
        print(f"     Next  : {prog_name()} --models   (to see models)")
        print(f"             {prog_name()} --set-model opencode/beam-free")
    else:
        print(f"     Test  : {prog_name()} \"say hi in 3 words\"")
    return 0


def cmd_set_model(args: list[str]) -> int:
    if not args:
        print(f"Usage: {prog_name()} --set-model <MODEL>", file=sys.stderr)
        return 1
    model = args[0].strip()
    cfg = load_free_cfg()
    if cfg.get("backend") == "colab":
        cfg["colab_model"] = model
    else:
        cfg["opencode_model"] = model
    save_free_cfg(cfg)
    update_sgptrc({"DEFAULT_MODEL": model})
    print(f"[OK] Default model set to: {model} (backend: {cfg.get('backend')})")
    return 0


def cmd_models() -> int:
    cfg = load_free_cfg()
    backend = cfg.get("backend", "opencode")
    rc = read_sgptrc()
    current = rc.get("DEFAULT_MODEL", "not set")
    print(f"Active backend : {backend}")
    print(f"Current model  : {current}\n")

    if backend == "colab":
        url = cfg.get("colab_url", "")
        if not url:
            print("No Colab URL configured. Run: sgpt-free --colab <NGROK_URL> [MODEL]")
            return 1
        models = fetch_colab_models(url, cfg.get("colab_api_key", ""))
        if not models:
            print(f"Could not reach {url}/v1/models (is your Colab cell running?).")
            return 1
        print(f"Models available on Colab ({url}):")
        for m in models:
            mark = "  <-- active" if m == current else ""
            print(f"  - {m}{mark}")
        print(f"\nSwitch with: {prog_name()} --set-model <MODEL>")
        return 0

    oc = shutil.which("opencode") or str(Path.home() / ".opencode" / "bin" / "opencode")
    if os.path.exists(oc):
        print("OpenCode CLI models ('opencode models'):")
        subprocess.run([oc, "models"])
        print()
    print("Common free model IDs:")
    for m in KNOWN_OPENCODE_FREE:
        mark = "  <-- active" if m == current else ""
        print(f"  - {m}{mark}")
    print(f"\nSwitch with: {prog_name()} --set-model <provider/model-id>")
    return 0


def cmd_status() -> int:
    cfg = load_free_cfg()
    rc = read_sgptrc()
    health = check_health()
    backend = cfg.get("backend", "opencode")
    print("========================================")
    print("  sgpt-free / sgpt-f Status")
    print("========================================")
    print(f"  Backend        : {backend}")
    print(f"  Default model  : {rc.get('DEFAULT_MODEL', '<not set>')}")
    if backend == "colab":
        print(f"  Colab URL      : {cfg.get('colab_url') or '<not set>'}")
    print(f"  API Base URL   : {rc.get('API_BASE_URL', '<not set>')}")
    print(f"  Functions      : {rc.get('OPENAI_USE_FUNCTIONS', 'false')}")
    print(f"  Streaming      : {'OFF' if rc.get('DISABLE_STREAMING') == 'true' else 'ON'}")
    print(f"  Adapter        : {'RUNNING (port ' + str(PORT) + ')' if health else 'STOPPED (auto-starts on next query)'}")
    print(f"  Config file    : {FREE_CFG}")
    print(f"  ShellGPT rc    : {SGPTRC}")
    if backend == "colab" and cfg.get("colab_url"):
        live = fetch_colab_models(cfg["colab_url"], cfg.get("colab_api_key", ""))
        if live:
            print(f"  Colab status   : ONLINE ({len(live)} model(s): {', '.join(live[:4])})")
        else:
            print("  Colab status   : UNREACHABLE (start your Colab cell or update URL)")
    print("========================================")
    return 0


def cmd_setup() -> int:
    p = prog_name()
    print("========================================")
    print("  sgpt-free Interactive Setup")
    print("========================================")
    print("  1) Google Colab + Ollama (ngrok URL — any model on free T4 GPU)")
    print("  2) OpenCode / OpenRouter (built-in free models or connected providers)")
    choice = input("\nChoose backend [1/2]: ").strip()

    if choice == "1":
        prev_url = load_free_cfg().get("colab_url", "")
        prompt = f"Enter Colab ngrok URL [{prev_url}]: " if prev_url else "Enter Colab ngrok URL (e.g. https://xxxx.ngrok-free.app): "
        url = input(prompt).strip() or prev_url
        if not url:
            print("Aborted: URL is required.")
            return 1
        url = normalize_url(url)
        print(f"Checking {url} ...")
        live = fetch_colab_models(url)
        model = ""
        if live:
            print("\nAvailable models on Colab:")
            for idx, m in enumerate(live, 1):
                print(f"  {idx}) {m}")
            sel = input(f"Pick a number or type model name [1 = {live[0]}]: ").strip()
            if not sel:
                model = live[0]
            elif sel.isdigit() and 1 <= int(sel) <= len(live):
                model = live[int(sel) - 1]
            else:
                model = sel
        else:
            model = input("Could not list models automatically. Type model name [sgpt-ai]: ").strip() or "sgpt-ai"
        return cmd_colab([url, model])

    if choice == "2":
        print("\nPopular free OpenCode / OpenRouter models:")
        for idx, m in enumerate(KNOWN_OPENCODE_FREE, 1):
            print(f"  {idx}) {m}")
        sel = input("Pick a number or type any provider/model-id: ").strip()
        if sel.isdigit() and 1 <= int(sel) <= len(KNOWN_OPENCODE_FREE):
            model = KNOWN_OPENCODE_FREE[int(sel) - 1]
        else:
            model = sel
        return cmd_opencode([model] if model else [])

    print(f"Invalid choice. Run '{p} --setup' again.")
    return 1


def cmd_functions(enabled: bool) -> int:
    val = "true" if enabled else "false"
    update_sgptrc({"OPENAI_USE_FUNCTIONS": val})
    print(f"[OK] OPENAI_USE_FUNCTIONS={val} in {SGPTRC}")
    if enabled:
        print("     Tip: if you haven't installed ShellGPT's default functions yet, run:")
        print(f"          {prog_name()} --install-functions")
    return 0


def cmd_logs() -> int:
    if not ADAPTER_LOG.exists():
        print(f"No log file yet at {ADAPTER_LOG}")
        return 0
    lines = ADAPTER_LOG.read_text(encoding="utf-8", errors="replace").splitlines()
    for line in lines[-60:]:
        print(line)
    return 0


def cmd_audit(args: list[str]) -> int:
    script = AUDIT_SH if AUDIT_SH.exists() else (Path(__file__).resolve().parent / "sgpt-audit.sh")
    if not script.exists():
        print(f"Audit script not found at {script}", file=sys.stderr)
        return 1
    return subprocess.run(["bash", str(script), *args]).returncode


def main() -> int:
    args = sys.argv[1:]
    if not args and sys.stdin.isatty():
        return cmd_help()

    first = args[0] if args else ""
    if first in ("--help", "--h", "-h"):
        return cmd_help()
    if first == "--setup":
        return cmd_setup()
    if first == "--colab":
        return cmd_colab(args[1:])
    if first == "--opencode":
        return cmd_opencode(args[1:])
    if first == "--set-model":
        return cmd_set_model(args[1:])
    if first in ("--models", "--list-models"):
        return cmd_models()
    if first == "--status":
        return cmd_status()
    if first == "--functions-on":
        return cmd_functions(True)
    if first == "--functions-off":
        return cmd_functions(False)
    if first == "--stop":
        stop_adapter()
        print("[OK] Local adapter stopped.")
        return 0
    if first == "--restart":
        stop_adapter()
        return 0 if ensure_adapter(quiet=False) else 1
    if first == "--logs":
        return cmd_logs()
    if first in ("--audit", "--test"):
        return cmd_audit(args[1:])

    # Pass-through to original ShellGPT (`sgpt`)
    os.environ["NO_PROXY"] = "localhost,127.0.0.1"
    os.environ["no_proxy"] = "localhost,127.0.0.1"

    if not ensure_adapter():
        return 1

    sgpt_bin = shutil.which("sgpt")
    if not sgpt_bin:
        print(
            "[sgpt-free] ERROR: original 'sgpt' command not found in PATH.\n"
            "Run ./install.sh or: pipx install shell-gpt",
            file=sys.stderr,
        )
        return 1

    os.execvp(sgpt_bin, ["sgpt", *args])
    return 0


if __name__ == "__main__":
    sys.exit(main())
